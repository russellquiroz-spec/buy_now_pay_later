table bnpl_audiencia_agg
	lineageTag: ea20008c-7523-492b-a1a1-63998d0beeea

	measure valor =
			
			VAR med = SELECTEDVALUE('Medidas Audiencia'[Medidas Audiencia Orden])
			RETURN
			SWITCH(med,
			    0, SUM(bnpl_audiencia_agg[Clientes]),
			    1, SUM(bnpl_audiencia_agg[Gross Sales]),
			    BLANK()
			    )
		formatString: #,0
		lineageTag: 9b0ce37c-a766-44c1-996c-cae7588fe4d0

	column ordenes
		dataType: int64
		formatString: 0
		lineageTag: 2e0ed6b1-5966-4346-90f8-a3b756065ba4
		summarizeBy: sum
		sourceColumn: ordenes

		annotation SummarizationSetBy = Automatic

