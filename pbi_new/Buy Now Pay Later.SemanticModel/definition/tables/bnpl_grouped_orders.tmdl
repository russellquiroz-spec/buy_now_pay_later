	measure EnrolledCustomersMetric = ```
			
			CALCULATE(
			    COUNTROWS(grid_bnpl), // Contar los clientes enrolados en 'grid_bnpl'
			    FILTER(
			        ALL(grid_bnpl), // Ignorar todos los filtros sobre 'grid_bnpl'
			        grid_bnpl[enrollment_cohort] = SELECTEDVALUE(bnpl_grouped_orders[enrollment_cohort]) && // Filtrar por la cohorte seleccionada en la matriz
			        grid_bnpl[oficina] IN VALUES(bnpl_grouped_orders[oficina]) && 
			        grid_bnpl[isEnrolled] = 1
			    )
			)
			```
		formatString: 0
		lineageTag: 9dfcaa0a-54cc-4afb-b10e-b0e459b71e71

	measure activeCusomerRate = DISTINCTCOUNT(bnpl_grouped_orders[netsuiteId])/[EnrolledCustomersMetric]
