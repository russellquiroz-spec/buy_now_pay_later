			    DISTINCTCOUNT(bnpl_grouped_orders[netsuiteId]),
			    NOT(ISBLANK(bnpl_grouped_orders[createdAt]) && bnpl_grouped_orders[deliveryStatus] = "COMPLETED")
			)
		formatString: 0
		lineageTag: beaa2984-0f28-4d68-b8cb-60bf448fe027

	measure activeCustomersOverCumulativeEnrolledCustomersRate = ```
			
			DIVIDE(
			    [activeCustomers],
			    [cumulativeEnrolledCustomers]
			)
			
			```
		lineageTag: 170fe632-cde8-4880-877d-4591a018c269

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 2activeCustomerRate =
			
			VAR Numerador = DISTINCTCOUNT(bnpl_grouped_orders[netsuiteId])
			VAR CohorteActual = SELECTEDVALUE(bnpl_grouped_orders[enrollment_cohort])
			VAR Denominador_Fijo =
			    CALCULATE(
			        DISTINCTCOUNT(grid_bnpl[netsuiteId]),
			        ALL(grid_bnpl),
			        grid_bnpl[isEnrolled] = 1,
			        grid_bnpl[enrollment_cohort] = CohorteActual,
			        KEEPFILTERS(bnpl_grouped_orders[oficina])
			    )
			RETURN DIVIDE(Numerador, Denominador_Fijo)
		lineageTag: 79ac8df8-58a6-43e5-9753-bfe543de23b4

	measure 2EnrolledCustomersMetric =
			
			CALCULATE(
			    DISTINCTCOUNT(grid_bnpl[netsuiteId]),
			    FILTER(
			        ALL(grid_bnpl),
			        grid_bnpl[enrollment_cohort] IN VALUES(bnpl_grouped_orders[enrollment_cohort]) &&
			        grid_bnpl[oficina] IN VALUES(bnpl_grouped_orders[oficina]) &&
			        grid_bnpl[isEnrolled] = 1
			    )
			)
		formatString: 0
		lineageTag: a28318cf-a70d-4b2f-a31e-2f22bdf15fb9

	measure '2Promedio Global Rate' =
			
			DIVIDE(
			    SUMX(VALUES(bnpl_grouped_orders[enrollment_cohort]), [2activeCustomerRate] * [2EnrolledCustomersMetric]),
			    SUMX(VALUES(bnpl_grouped_orders[enrollment_cohort]), [2EnrolledCustomersMetric])
			)
		lineageTag: f5cf51d7-ddac-4e5a-9197-6948dee86456

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TasaSupervivencia =
			
			VAR __CohortSel = SELECTEDVALUE('Cohorte (Total)'[enrollment_cohort])
			RETURN
			IF(
			    __CohortSel = "WAVG",
			    /* === TOTAL (promedio ponderado por inscritos) === */
			    DIVIDE(
			        SUMX(
			            -- quita SOLO el filtro de cohorte pero respeta el resto (fechas, status, etc.)
			            ALLSELECTED(bnpl_grouped_orders[enrollment_cohort]),
			            CALCULATE(
			                [2activeCustomerRate] * [2EnrolledCustomersMetric]
			                -- KEEPFILTERS(VALUES(bnpl_grouped_orders[deliveryStatus]))  -- opcional si manejas múltiples estados
			            )
			        ),
			        SUMX(
			            ALLSELECTED(bnpl_grouped_orders[enrollment_cohort]),
			            CALCULATE(
			                [2EnrolledCustomersMetric]
			                -- KEEPFILTERS(VALUES(bnpl_grouped_orders[deliveryStatus]))
			            )
			        )
			    ),
			    /* === COHORTE INDIVIDUAL (Numerador/Denominador) === */
			    VAR __Numerador =
			        CALCULATE(
			            DISTINCTCOUNT(bnpl_grouped_orders[netsuiteId]),
			            TREATAS({ __CohortSel }, bnpl_grouped_orders[enrollment_cohort])
			            -- aquí NO usamos ALL(...) para no romper el slicer de fechas ni otros filtros
			        )
			    VAR __Denominador =
			        CALCULATE(
			            DISTINCTCOUNT(grid_bnpl[netsuiteId]),
			            grid_bnpl[isEnrolled] = 1,
			            TREATAS({ __CohortSel }, grid_bnpl[enrollment_cohort])
			        )
			    RETURN DIVIDE(__Numerador, __Denominador)
			)
		lineageTag: 928eca03-5be8-4ae8-87b1-65669c612a18

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure frecuencyPlot = ```
			
			VAR __CohortSel = SELECTEDVALUE('Cohorte (Total)'[enrollment_cohort])
			RETURN
			IF(
			    __CohortSel = "WAVG",
			    DIVIDE(
			        SUMX(
			            
			            ALLSELECTED(bnpl_grouped_orders[enrollment_cohort]),
			            CALCULATE(
			                DISTINCTCOUNT(bnpl_grouped_orders[salesOrderId])
			            )
			        ),
			        SUMX(
			            ALLSELECTED(bnpl_grouped_orders[enrollment_cohort]),
			            CALCULATE(
			                DISTINCTCOUNT(bnpl_grouped_orders[netsuiteId])
			            )
			        )
			    ),
			    /* === COHORTE INDIVIDUAL (Numerador/Denominador) === */
			    VAR __Numerador =
			        CALCULATE(
			            DISTINCTCOUNT(bnpl_grouped_orders[salesOrderId]),
			            TREATAS({ __CohortSel }, bnpl_grouped_orders[enrollment_cohort])
			            -- aquí NO usamos ALL(...) para no romper el slicer de fechas ni otros filtros
			        )
			    VAR __Denominador =
			        CALCULATE(
			            DISTINCTCOUNT(bnpl_grouped_orders[netsuiteId]),
			            TREATAS({ __CohortSel }, bnpl_grouped_orders[enrollment_cohort])
			        )
			    RETURN DIVIDE(__Numerador, __Denominador)
			)
			```
		lineageTag: 569857fd-73a3-485f-a8c1-2546d4540383

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure dropSizePlot = ```
			
			VAR __CohortSel = SELECTEDVALUE('Cohorte (Total)'[enrollment_cohort])
			RETURN
			IF(
			    __CohortSel = "WAVG",
			    DIVIDE(
			        SUMX(
			            
			            ALLSELECTED(bnpl_grouped_orders[enrollment_cohort]),
			            CALCULATE(
			                SUM(bnpl_grouped_orders[totalPrice])
			            )
			        ),
			        SUMX(
			            ALLSELECTED(bnpl_grouped_orders[enrollment_cohort]),
			            CALCULATE(
			                DISTINCTCOUNT(bnpl_grouped_orders[salesOrderId])
			            )
			        )
			    ),
			    /* === COHORTE INDIVIDUAL (Numerador/Denominador) === */
			    VAR __Numerador =
			        CALCULATE(
			            sum(bnpl_grouped_orders[totalPrice]),
			            TREATAS({ __CohortSel }, bnpl_grouped_orders[enrollment_cohort])
			            -- aquí NO usamos ALL(...) para no romper el slicer de fechas ni otros filtros
			        )
			    VAR __Denominador =
			        CALCULATE(
			            DISTINCTCOUNT(bnpl_grouped_orders[salesOrderId]),
			            TREATAS({ __CohortSel }, bnpl_grouped_orders[enrollment_cohort])
			        )
			    RETURN DIVIDE(__Numerador, __Denominador)
			)
			```
		lineageTag: 59e338ed-b969-4a3c-8c09-6ef580552914

		annotation PBI_FormatHint = {"isGeneralNumber":true}

