				        "stage", [stage1],
				        "loanDisbursementIndex", [loanDisbursementIndex],
				        "deliveryAt", [deliveryAt],
				        "totalAmount", [totalAmount],
				        "orden", 1
				    ),
				    SELECTCOLUMNS(
				        FILTER(bnpl_loss_rates, NOT(ISBLANK([stage2]))),
				        "netsuiteId", [netsuiteId],
