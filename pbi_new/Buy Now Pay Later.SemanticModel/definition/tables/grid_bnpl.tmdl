	column customerAgeRangeAtEligibility =
			
			SWITCH(
			    TRUE(),
			    grid_bnpl[customerAgeAtEligibility] <= 20, "<=20",
			    grid_bnpl[customerAgeAtEligibility] >= 21 && grid_bnpl[customerAgeAtEligibility] <= 30, "21-30",
			    grid_bnpl[customerAgeAtEligibility] >= 31 && grid_bnpl[customerAgeAtEligibility] <= 40, "31-40",
			    grid_bnpl[customerAgeAtEligibility] >= 41 && grid_bnpl[customerAgeAtEligibility] <= 50, "41-50",
			    grid_bnpl[customerAgeAtEligibility] >= 51 && grid_bnpl[customerAgeAtEligibility] <= 60, "51-60",
			    grid_bnpl[customerAgeAtEligibility] > 60, "60+",
			    "Unknown"
			)
		lineageTag: 4f9e8d7a-c897-436b-9689-e24dab2d3d1d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

