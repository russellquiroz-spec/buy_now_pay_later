table grid_bnpl
	lineageTag: 7d7ccaa7-f686-4f7d-aca3-2f551a474e07

	measure cumulativeEnrolledCustomers = ```
			
			CALCULATE(
			    DISTINCTCOUNT(grid_bnpl[netsuiteId]),
			    FILTER(
			        ALL(grid_bnpl[enrolledAtClean]),
			        grid_bnpl[enrolledAtClean] <= MAX(bnpl_grouped_orders[createdAt]) && NOT(ISBLANK(grid_bnpl[enrolledAtClean]))
			    )
			)
			
			```
		formatString: 0
		lineageTag: daac9677-e497-4e3a-a86e-9b1bf3a5bad9

