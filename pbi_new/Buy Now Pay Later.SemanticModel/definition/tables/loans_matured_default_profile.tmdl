		dataType: int64
		formatString: 0
		lineageTag: c18e3a5a-22be-479e-850b-7dd51b968182
		summarizeBy: sum
		sourceColumn: ordersCountMarketPlacePostLastBnplOrder

		annotation SummarizationSetBy = Automatic

	column ordersAfterLastBnplOrder = ```
			
			IF(
			    loans_matured_default_profile[ordersCountAliadoPostLastBnplOrder] + loans_matured_default_profile[ordersCountMarketPlacePostLastBnplOrder] >= 1, 
			    1, 
			    0
			)
			```
		formatString: 0
		lineageTag: fc24108f-b609-4812-a639-6d981f879179
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column fraudFlag =
			
			SWITCH(
			    TRUE(),
			    loans_matured_default_profile[flag@15DaysLate] = 0, "Not Defaulted", loans_matured_default_profile[flag@15DaysLate] = 1 && NOT(ISBLANK(loans_matured_default_profile[paidDate])) , "Defaulted & Recovered", loans_matured_default_profile[flag@15DaysLate] = 1 && loans_matured_default_profile[ordersAfterLastBnplOrder] == 1, "Defaulted & Still Active with Other Payment Methods",
			    loans_matured_default_profile[flag@15DaysLate] = 1 && loans_matured_default_profile[ordersAfterLastBnplOrder] == 0, "Potential Fraud"
			)
		lineageTag: 95a8a081-70ea-4a64-a805-61ad92f2be01
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column psTransactionalProfile =
			
			LOOKUPVALUE(
			    ps_transactional_profile[transactionalProfile],  // Columna que queremos traer
			    ps_transactional_profile[Id cliente], loans_matured_default_profile[netsuiteId]  // Llave de la relación
			)
		lineageTag: de0fcf40-20e5-4b4e-a91a-d704b78dce95
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column crossFraudFlag =
			
			SWITCH(
			    TRUE(),
			    loans_matured_default_profile[psTransactionalProfile] = "03-Mostly Fraud" && loans_matured_default_profile[fraudFlag] == "Potential Fraud", 1,0
			)
		formatString: 0
		lineageTag: ab9c5182-1ce2-4204-9e60-388e7045fb76
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

