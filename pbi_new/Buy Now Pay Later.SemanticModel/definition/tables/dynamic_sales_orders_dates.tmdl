table dynamic_sales_orders_dates
	lineageTag: 23386c9f-b9e5-47db-a3df-e57ef93e64bb

	column Date
		formatString: Long Date
		lineageTag: 17c15d68-f6d6-48ff-afba-731e6f27b9dd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

