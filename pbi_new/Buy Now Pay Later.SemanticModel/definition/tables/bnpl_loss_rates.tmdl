table bnpl_loss_rates
	lineageTag: 2cefecbe-b98d-462a-81da-add2a0a26734

	measure revenueAfterTaxes = SUM(bnpl_loss_rates[rabbitRevenue]) / 1.16
		lineageTag: bf6e0bd0-0c5a-4bf3-9f77-dfc2ef2e9931

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure revenueBeforeTaxes = SUM(bnpl_loss_rates[rabbitRevenue])
		lineageTag: d8872648-d6f1-4333-b871-e6c2c9cf8a8b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure dynamicRevenue = ```
			
			    VAR selectedView = SELECTEDVALUE('revenue_view_selector'[ViewType], "Sin IVA")
			    RETURN
			        SWITCH(
			            selectedView,
			            "Sin IVA", [revenueAfterTaxes],
			            "Con IVA", [revenueBeforeTaxes],
			            [revenueAfterTaxes]
			        )
			```
		lineageTag: ae810a4e-1307-4382-8d42-095c991c62d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure dynamicTotalRevenue = ```
			
			    VAR selectedView = SELECTEDVALUE('revenue_view_selector'[ViewType], "After Taxes")
			    RETURN
			        SWITCH(
			            selectedView,
			            "After Taxes", SUM(bnpl_loss_rates[totalRevenue]) / 1.16,
			            "Before Taxes", SUM(bnpl_loss_rates[totalRevenue]),
			            SUM(bnpl_loss_rates[totalRevenue])
			        )
			```
		lineageTag: 693ba3f4-c695-4917-939b-7f8320bd7f36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

