	column seasonalityDeltaVolume =
			
			LOOKUPVALUE(
			    seasonality_delta[seasonalityDeltaVolume],    -- Columna de Tabla B que deseas traer
			    seasonality_delta[fromMonth], bnpl_loss_rates[enrollmentMonth],    -- Matchear la columna From con monthsSinceEnrollmentText
			    seasonality_delta[toMonth], bnpl_loss_rates[monthsSinceEnrollmentText]                 -- Matchear la columna To con enrollmentMonth
			)
		lineageTag: 44d86bea-922e-4250-af51-80699546ba15
		summarizeBy: sum

