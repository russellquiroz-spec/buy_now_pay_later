	column loanDisbursementIndex =
			
			SWITCH(
			    TRUE(),
			    bnpl_loss_rates[rank] <= 3, FORMAT(bnpl_loss_rates[rank], "0"),  -- Convertir número a texto
			    bnpl_loss_rates[rank] >= 4, "4+"  -- Devolver "3+" como texto
			)
		lineageTag: 8a06f737-4eec-4796-81ab-d2e296d3d677
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

