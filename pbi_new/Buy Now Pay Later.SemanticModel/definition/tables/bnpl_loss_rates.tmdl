	column stage1 = IF(bnpl_loss_rates[deliveryAt] <= TODAY() - 115, "Ongoing", BLANK())
		lineageTag: 468e00f4-b3d1-4c02-8ed4-7df80a5d1750
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column stage2 = ```
			
			IF(
			    bnpl_loss_rates[deliveryAt] <= TODAY() - 115, 
			    IF(
			        [daysPastDue] >= 1, 
			        "DQ 1-6", 
			        "Paid"
			    ), 
			    BLANK()
			)
			```
		lineageTag: 5aeb837c-9d6d-4fb9-8f9c-f04ab794247c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column stage3 = ```
			
			IF(
			    bnpl_loss_rates[deliveryAt] <= TODAY() - 115, 
