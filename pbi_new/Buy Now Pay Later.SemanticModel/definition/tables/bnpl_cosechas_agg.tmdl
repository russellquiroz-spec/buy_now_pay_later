			                && bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			        )
			    )
			
			-- Primer mes del rango seleccionado
			VAR MesInicio =
			    CALCULATE(
			        MIN( bnpl_cosechas_agg[mes_tx] ),
			        ALLSELECTED( bnpl_cosechas_agg )
			    )
			
			-- Índice (numérico) para pendiente: diferencia de "pasos" entre MesInicio y MesReferencia
			VAR IndexInicio =
			    CALCULATE( MIN( bnpl_cosechas_agg[IndexMes] ), ALLSELECTED( bnpl_cosechas_agg ) )
			
			VAR IndexRef =
			    CALCULATE(
			        MAX( bnpl_cosechas_agg[IndexMes] ),
			        FILTER( ALLSELECTED( bnpl_cosechas_agg ), bnpl_cosechas_agg[mes_tx] = MesReferencia )
			    ) - IndexInicio
			
			-- Y0: primer valor del indicador (ventas/órdenes) en MesInicio
			VAR Y0 =
