	measure tendenciaEnroladosProyectada = ```
			
			VAR FechaCorte =
			    CALCULATE(
			        MIN(bnpl_cosechas_agg[mes_ft_tx_bnpl]),
			        ALLSELECTED(bnpl_cosechas_agg)
			    )
			
			VAR MesReferencia =
			    CALCULATE(
			        MAX(bnpl_cosechas_agg[mes_tx]),
			        FILTER(
			            ALLSELECTED(bnpl_cosechas_agg),
			            bnpl_cosechas_agg[mes_tx] < FechaCorte &&
			            bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			        )
			    )
			
			-- Definir 3 meses atrás
			VAR FechaInicioRango =
			    EDATE(MesReferencia, -2)
			
			-- Calcular TasaY acumulando en los últimos 3 meses antes de enrolamiento
			VAR TasaY =
			    CALCULATE(
			        DIVIDE(
			            SUM(bnpl_cosechas_agg[gross_sales]) - SUM(bnpl_cosechas_agg[gross_sales_ft]),
			            SUM(bnpl_cosechas_agg[gross_sales_ft])
			        ),
			        FILTER(
			            ALLSELECTED(bnpl_cosechas_agg),
			            bnpl_cosechas_agg[mes_tx] >= FechaInicioRango &&
			            bnpl_cosechas_agg[mes_tx] <= MesReferencia &&
			            bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			        )
			    )
			
			-- Normalización del índice
			VAR IndexInicio =
			    CALCULATE(
			        MIN(bnpl_cosechas_agg[IndexMes]),
			        ALLSELECTED(bnpl_cosechas_agg)
			    )
			
			VAR IndexReferencia =
			    CALCULATE(
			        MAX(bnpl_cosechas_agg[IndexMes]),
			        FILTER(
			            ALLSELECTED(bnpl_cosechas_agg),
			            bnpl_cosechas_agg[mes_tx] = MesReferencia
			        )
			    ) - IndexInicio
			
			VAR Pendiente = DIVIDE(TasaY, IndexReferencia)
			
			VAR IndexActual =
			    SELECTEDVALUE(bnpl_cosechas_agg[IndexMes]) - IndexInicio
			
			RETURN
			    IF(
			        NOT ISBLANK(IndexActual) && IndexActual >= 0,
			        Pendiente * IndexActual
			    )
			
			```
		lineageTag: b79eda44-0a01-4212-ab41-3e6aaff75f1c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

