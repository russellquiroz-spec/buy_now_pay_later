	measure RebaseSobreTendencia = ```
			
			VAR FechaCorte =
			    CALCULATE(
			        MIN(bnpl_cosechas_agg[mes_ft_tx_bnpl]),
			        ALLSELECTED(bnpl_cosechas_agg)
			    )
			VAR TablaMeses =
			    FILTER(
			        VALUES(bnpl_cosechas_agg[mes_tx]),
			        bnpl_cosechas_agg[mes_tx] >= FechaCorte
			    )
			RETURN
			    SUMX(
			        TablaMeses,
			        CALCULATE([% variación Gross Sales], bnpl_cosechas_agg[flg_cte_bnpl]= "Y")
			    )
			
			```
		lineageTag: fb927785-36ca-4fcb-961f-0fba16926bf2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure baseTendencia = ```
			
			VAR FechaCorte =
			    CALCULATE( MIN( bnpl_cosechas_agg[mes_ft_tx_bnpl] ), ALLSELECTED( bnpl_cosechas_agg ) )
			
			VAR MesReferencia =
			    CALCULATE(
			        MAX( bnpl_cosechas_agg[mes_tx] ),
			        FILTER(
			            ALLSELECTED( bnpl_cosechas_agg ),
			            bnpl_cosechas_agg[mes_tx] < FechaCorte &&
			            bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			        )
			    )
			
			VAR FechaInicioRango = EDATE( MesReferencia, -2 )
			
			VAR TasaY =
			    CALCULATE(
			        DIVIDE(
			            SUM( bnpl_cosechas_agg[gross_sales] ) - SUM( bnpl_cosechas_agg[gross_sales_ft] ),
			            SUM( bnpl_cosechas_agg[gross_sales_ft] )
			        ),
			        FILTER(
			            ALLSELECTED( bnpl_cosechas_agg ),
			            bnpl_cosechas_agg[mes_tx] >= FechaInicioRango &&
			            bnpl_cosechas_agg[mes_tx] <= MesReferencia &&
			            bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			        )
			    )
			
			VAR IndexInicio =
			    CALCULATE( MIN( bnpl_cosechas_agg[IndexMes] ), ALLSELECTED( bnpl_cosechas_agg ) )
			
			VAR IndexReferencia =
			    CALCULATE(
			        MAX( bnpl_cosechas_agg[IndexMes] ),
			        FILTER( ALLSELECTED( bnpl_cosechas_agg ), bnpl_cosechas_agg[mes_tx] = MesReferencia )
			    ) - IndexInicio
			
			VAR Pendiente = DIVIDE( TasaY, IndexReferencia )
			
			-- Tabla de meses a sumar (>= FechaCorte) con su índice
			VAR MesesDesdeCorte =
			    FILTER(
			        SUMMARIZE(
			            ALLSELECTED( bnpl_cosechas_agg ),
			            bnpl_cosechas_agg[mes_tx],
			            "Idx", MAX( bnpl_cosechas_agg[IndexMes] )
			        ),
			        bnpl_cosechas_agg[mes_tx] >= FechaCorte
			    )
			
			RETURN
			IF(
			    ISBLANK( MesReferencia ) || IndexReferencia <= 0,
			    BLANK(),
			    SUMX( MesesDesdeCorte, Pendiente * ( [Idx] - IndexInicio ) )
			)
			
			
			```
		lineageTag: 2c36910e-ef9b-42e8-a37c-337b67fc29bf

