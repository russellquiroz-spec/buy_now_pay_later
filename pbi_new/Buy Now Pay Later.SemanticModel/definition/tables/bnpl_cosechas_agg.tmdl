	measure tendenciaDropEnroladosProyectada =
			
			VAR __IndexCtx = SELECTEDVALUE(bnpl_cosechas_agg[IndexMes])
			
			VAR FechaCorte =
			    CALCULATE(
			        MIN(bnpl_cosechas_agg[mes_ft_tx_bnpl]),
			        REMOVEFILTERS(bnpl_cosechas_agg)
			    )
			
			VAR MesReferencia =
			    CALCULATE(
			        MAX(bnpl_cosechas_agg[mes_tx]),
			        FILTER(
			            REMOVEFILTERS(bnpl_cosechas_agg),
			            bnpl_cosechas_agg[mes_tx] < FechaCorte &&
			            bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			        )
			    )
			
			VAR FechaInicioRango = EDATE(MesReferencia, -2)
			
			VAR TasaY =
			    CALCULATE(
			        DIVIDE(
			            SUM(bnpl_cosechas_agg[gross_sales]) - SUM(bnpl_cosechas_agg[gross_sales_ft]),
			            SUM(bnpl_cosechas_agg[gross_sales_ft])
			        ),
			        FILTER(
			            REMOVEFILTERS(bnpl_cosechas_agg),
			            bnpl_cosechas_agg[mes_tx] >= FechaInicioRango &&
			            bnpl_cosechas_agg[mes_tx] <= MesReferencia &&
			            bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			        )
			    )
			
			VAR IndexInicio =
			    CALCULATE(
			        MIN(bnpl_cosechas_agg[IndexMes]),
			        REMOVEFILTERS(bnpl_cosechas_agg)
			    )
			
			VAR IndexReferencia =
			    CALCULATE(
			        MAX(bnpl_cosechas_agg[IndexMes]),
			        FILTER(
			            REMOVEFILTERS(bnpl_cosechas_agg),
			            bnpl_cosechas_agg[mes_tx] = MesReferencia
			        )
			    ) - IndexInicio
			
			VAR Pendiente = DIVIDE(TasaY, IndexReferencia)
			
			VAR IndexActual =
			    IF( NOT ISBLANK(__IndexCtx), __IndexCtx - IndexInicio )
			
			RETURN
			    IF(
			        ISBLANK(MesReferencia) || IndexReferencia <= 0 || ISBLANK(IndexActual) || IndexActual < 0,
			        BLANK(),
			        Pendiente * IndexActual
			    )
