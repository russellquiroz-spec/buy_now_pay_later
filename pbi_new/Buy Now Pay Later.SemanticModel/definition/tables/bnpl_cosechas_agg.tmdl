	measure tendenciaEnroladosDropProyectada =
			
			VAR FechaCorte =
			    CALCULATE(
			        MIN( bnpl_cosechas_agg[mes_ft_tx_bnpl] ),
			        ALLSELECTED( bnpl_cosechas_agg )
			    )
			
			-- Último mes ANTES del primer enrolamiento (solo clientes BNPL = "Y")
			VAR MesReferencia =
			    CALCULATE(
			        MAX( bnpl_cosechas_agg[mes_tx] ),
			        FILTER(
			            ALLSELECTED( bnpl_cosechas_agg ),
			            bnpl_cosechas_agg[mes_tx] < FechaCorte
			                && bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			        )
			    )
			
			-- Primer mes del rango seleccionado
			VAR MesInicio =
			    CALCULATE(
			        MIN( bnpl_cosechas_agg[mes_tx] ),
			        ALLSELECTED( bnpl_cosechas_agg )
			    )
			
			-- Índice (numérico) para pendiente: diferencia de "pasos" entre MesInicio y MesReferencia
			VAR IndexInicio =
			    CALCULATE( MIN( bnpl_cosechas_agg[IndexMes] ), ALLSELECTED( bnpl_cosechas_agg ) )
			
			VAR IndexRef =
			    CALCULATE(
			        MAX( bnpl_cosechas_agg[IndexMes] ),
			        FILTER( ALLSELECTED( bnpl_cosechas_agg ), bnpl_cosechas_agg[mes_tx] = MesReferencia )
			    ) - IndexInicio
			
			-- Y0: primer valor del indicador (ventas/órdenes) en MesInicio
			VAR Y0 =
			    CALCULATE(
			        DIVIDE( SUM( bnpl_cosechas_agg[gross_sales] ), SUM( bnpl_cosechas_agg[ordenes] ) ),
			        FILTER( ALLSELECTED( bnpl_cosechas_agg ), bnpl_cosechas_agg[mes_tx] = MesInicio && bnpl_cosechas_agg[flg_cte_bnpl] = "Y")
			    )
			
			-- Yref: valor del indicador en MesReferencia (antes del primer enrolamiento)
			VAR Yref =
			    CALCULATE(
			        DIVIDE( SUM( bnpl_cosechas_agg[gross_sales] ), SUM( bnpl_cosechas_agg[ordenes] ) ),
			        FILTER(
			            ALLSELECTED( bnpl_cosechas_agg ),
			            bnpl_cosechas_agg[mes_tx] = MesReferencia
			                && bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			        )
			    )
			
			-- Pendiente de la recta que une (MesInicio,Y0) con (MesReferencia,Yref)
			VAR m = DIVIDE( Yref - Y0, IndexRef )
			
			-- X actual (en pasos de índice desde el inicio)
			VAR x =
			    SELECTEDVALUE( bnpl_cosechas_agg[IndexMes] ) - IndexInicio
			
			RETURN
			IF(
			    NOT ISBLANK( x ) && x >= 0,
			    Y0 + m * x
			)
		lineageTag: f4cc69b7-7762-4448-b94e-0c88d29cc0c1

