	measure incrementoSupervivencia = ```
			
			VAR FechaCorte =
			    CALCULATE(
			        MIN(bnpl_cosechas_agg[mes_ft_tx_bnpl]),
			        ALLSELECTED(bnpl_cosechas_agg)
			    )
			VAR bnplAfter = 
			    CALCULATE(
			        [supervivencia], 
			        bnpl_cosechas_agg[mes_tx]>= FechaCorte, 
			        bnpl_cosechas_agg[flg_cte_bnpl] = "Y")
			VAR noBnplAfter = 
			    CALCULATE(
			        [supervivencia], 
			        bnpl_cosechas_agg[mes_tx]>= FechaCorte, 
			        bnpl_cosechas_agg[flg_cte_bnpl] = "N")
			VAR bnplBefore = 
			    CALCULATE(
			        [supervivencia], 
			        bnpl_cosechas_agg[mes_tx] < FechaCorte, 
			        bnpl_cosechas_agg[flg_cte_bnpl] = "Y")
			VAR noBnplBefore = 
			    CALCULATE(
			        [supervivencia], 
			        bnpl_cosechas_agg[mes_tx] < FechaCorte, 
			        bnpl_cosechas_agg[flg_cte_bnpl] = "N")
			RETURN
			    DIVIDE(DIVIDE(bnplAfter, noBnplAfter),DIVIDE(bnplBefore,noBnplBefore))-1
			```
