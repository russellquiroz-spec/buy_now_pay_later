table bnpl_cosechas_agg
	lineageTag: 4e912985-d9b2-4b14-86e6-37dde15bbd8f

	measure '% variación Gross Sales' = (SUM(bnpl_cosechas_agg[gross_sales]) - SUM(bnpl_cosechas_agg[gross_sales_ft])) / SUM(bnpl_cosechas_agg[gross_sales_ft])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 240eb44c-5a94-48d3-9812-f29dce37e264

	measure 'Fecha 10% Y' = ```
			
			VAR GrupoFiltrado =
			    FILTER(
			        ALL(bnpl_cosechas_agg),
			        bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			    )
			
			VAR TotalY =
			    CALCULATE(
			        SUM(bnpl_cosechas_agg[clientes_cosecha]),
			        bnpl_cosechas_agg[flg_cte_bnpl] = "Y"
			    )
			
			VAR Acumulado10 = TotalY * 0.1
			
			VAR TablaAcumuladaY =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            GrupoFiltrado,
			            bnpl_cosechas_agg[mes_ft_tx_bnpl],
			            "SumaFecha", SUM(bnpl_cosechas_agg[clientes_cosecha])
			        ),
			        "Acumulado",
			        VAR FechaActual = bnpl_cosechas_agg[mes_ft_tx_bnpl]
			        RETURN
			            CALCULATE(
			                SUM(bnpl_cosechas_agg[clientes_cosecha]),
			                bnpl_cosechas_agg[flg_cte_bnpl] = "Y",
			                bnpl_cosechas_agg[mes_ft_tx_bnpl] <= FechaActual
			            )
			    )
			
			RETURN
			    MINX(
			        FILTER(TablaAcumuladaY, [Acumulado] >= Acumulado10),
			        bnpl_cosechas_agg[mes_ft_tx_bnpl]
			    )
			
			```
		formatString: General Date
		lineageTag: 0f947ff8-75f2-4c9e-8aac-21be09f054a6

