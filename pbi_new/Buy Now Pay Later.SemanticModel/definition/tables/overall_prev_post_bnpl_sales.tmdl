table overall_prev_post_bnpl_sales
	lineageTag: 97b6277d-48c7-45c5-a869-38abddd387bb

	measure frequencyOP = DISTINCTCOUNT(overall_prev_post_bnpl_sales[salesOrderId]) / DISTINCTCOUNT(overall_prev_post_bnpl_sales[netsuiteId])
		lineageTag: f109dc87-98fe-4573-9a13-f597f5cee3aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MonthlyGrossSales = sum(overall_prev_post_bnpl_sales[grossSales])/DISTINCTCOUNT(overall_prev_post_bnpl_sales[monthsToOrSinceEnrollment])/DISTINCTCOUNT(overall_prev_post_bnpl_sales[netsuiteId])
		lineageTag: 3e103f59-fb7e-47f9-acc3-4d084e000cb1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure grossSalesMetric = sum(overall_prev_post_bnpl_sales[grossSales]) / DISTINCTCOUNT(overall_prev_post_bnpl_sales[netsuiteId])
		lineageTag: 2cadacf0-6526-4f77-b11b-9363cf659d61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MaxMonthsSinceEnrollmentPostBNPLMetric =
			
			CALCULATE(
			    MAXX(
			        FILTER(
			            ALL(overall_prev_post_bnpl_sales),
			            overall_prev_post_bnpl_sales[treshold] = "post BNPL"
			        ),
			        overall_prev_post_bnpl_sales[monthsToOrSinceEnrollment]
			    ),
			    REMOVEFILTERS(overall_prev_post_bnpl_sales[treshold])
			)
		formatString: 0
		lineageTag: f3fe155a-4f3c-4e80-af24-1c30c40d58cd

	measure historicalFrequency = COUNT(overall_prev_post_bnpl_sales[salesOrderId]) / DISTINCTCOUNT(overall_prev_post_bnpl_sales[netsuiteId])
		lineageTag: a98ab5e6-5a59-4881-b3fb-9bb69f052de3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

