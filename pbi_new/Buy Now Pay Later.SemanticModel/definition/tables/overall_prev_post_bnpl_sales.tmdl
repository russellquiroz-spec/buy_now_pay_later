	column MaxMonthsSinceEnrollmentPostBNPL = ```
			
			CALCULATE(
			    MAX(overall_prev_post_bnpl_sales[monthsToOrSinceEnrollment]),
			    FILTER(
			        overall_prev_post_bnpl_sales, 
			        overall_prev_post_bnpl_sales[treshold] = "post BNPL"
			    )
			)
			```
		formatString: 0
		lineageTag: a9f959a8-5a1e-4b35-9cf4-e08c4d9691e1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column validMonths = IF(overall_prev_post_bnpl_sales[monthsToOrSinceEnrollment] <= overall_prev_post_bnpl_sales[MaxMonthsSinceEnrollmentPostBNPLMetric], 1, 0)
		formatString: 0
		lineageTag: b2f0bbc0-5161-40d2-87df-0b16ed0938e5
