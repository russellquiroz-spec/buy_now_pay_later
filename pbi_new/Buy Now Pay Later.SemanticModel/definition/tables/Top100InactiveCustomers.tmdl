	partition Top100InactiveCustomers = calculated
		mode: import
		source = ```
				
				TOPN(
				    100, 
				    FILTER(
				        grid_bnpl, 
				        grid_bnpl[bnplIsActive] = 0
				    ),
				    grid_bnpl[bnplTotalOrderVolume], 
				    DESC
				)
				```

	annotation PBI_Id = 4982a449de344fdd9156a8e4e9ddfc7c

