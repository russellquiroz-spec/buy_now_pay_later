              {
                "textRuns": [
                  {
                    "value": "Seis definiciones que hay que tener presentes",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#00AEEF",
                      "fontWeight": "bold"
                    }
                  }
                ]
