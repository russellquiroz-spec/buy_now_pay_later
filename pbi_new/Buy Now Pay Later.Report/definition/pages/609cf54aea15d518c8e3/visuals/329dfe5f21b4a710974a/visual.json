              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Qué mide: Cuántos clientes pasan de una etapa de mora a la siguiente (roll rates).\nUniverso y corte: Cada pedido se despliega en una fila por etapa alcanzada; las columnas son la etapa SIGUIENTE del mismo pedido. Cuenta pedidos distintos, no clientes, pese al subtitulo. La tabla no tiene relación con el grid: los slicers de la página no la afectan.\nDe dónde sale: la tabla calculada en DAX bnpl_loss_rates_with_lead, derivada de pbi_bnpl.bnpl_loss_rates.'"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Qué mide: Cuántos clientes pasan de una etapa de mora a la siguiente (roll rates).\nUniverso y corte: Cada pedido se despliega en una fila por etapa alcanzada; las columnas son la etapa SIGUIENTE del mismo pedido. Cuenta pedidos distintos, no clientes, pese al subtitulo. La tabla no tiene relación con el grid: los slicers de la página no la afectan.\nDe dónde sale: la tabla calculada en DAX bnpl_loss_rates_with_lead, derivada de pbi_bnpl.bnpl_loss_rates.'"
                }
              }
            }
          }
        }
      ]
