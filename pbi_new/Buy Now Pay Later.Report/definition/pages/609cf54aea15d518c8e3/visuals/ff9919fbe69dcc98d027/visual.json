      "visualHeaderTooltip": [
        {
          "properties": {
            "type": {
              "expr": {
                "Literal": {
                  "Value": "'Default'"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Qué mide: Qué porcentaje del saldo de cada cierre esta en mora, abierto por tramo de días de atraso.\nUniverso y corte: El porcentaje es un cálculo del propio visual: saldo del bucket entre ''Cumulative Deployed & Matured Capital''. Ese denominador es la suma del saldo de TODAS las filas del mismo corte, ignorando los filtros de bucket y de días del visual. Es decir, saldo vivo, no capital desplegado. Las medidas PAR de Vintage Analysis dividen entre capital desplegado ($1,760M contra $276M de saldo), así que las dos cifras no son la misma tasa. El visual excluye los pedidos pagados y los de 120 días o más. El último corte es el mes en curso, incompleto.\nDe dónde sale: la vista pbi_bnpl.months_closes, sobre bnpl.par_snapshot.'"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Qué mide: Qué porcentaje del saldo de cada cierre esta en mora, abierto por tramo de días de atraso.\nUniverso y corte: El porcentaje es un cálculo del propio visual: saldo del bucket entre ''Cumulative Deployed & Matured Capital''. Ese denominador es la suma del saldo de TODAS las filas del mismo corte, ignorando los filtros de bucket y de días del visual. Es decir, saldo vivo, no capital desplegado. Las medidas PAR de Vintage Analysis dividen entre capital desplegado ($1,760M contra $276M de saldo), así que las dos cifras no son la misma tasa. El visual excluye los pedidos pagados y los de 120 días o más. El último corte es el mes en curso, incompleto.\nDe dónde sale: la vista pbi_bnpl.months_closes, sobre bnpl.par_snapshot.'"
                }
              }
            }
          }
        }
      ]
