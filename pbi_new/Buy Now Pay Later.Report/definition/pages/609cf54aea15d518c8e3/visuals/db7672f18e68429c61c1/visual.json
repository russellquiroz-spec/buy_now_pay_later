            "type": {
              "expr": {
                "Literal": {
                  "Value": "'Default'"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Qué mide: Cómo se reparte porcentualmente la venta financiada viva entre los buckets de mora, mes a mes.\nUniverso y corte: Mismo universo que la grafica de barras de arriba: una fila por pedido y por corte de fin de mes, con la venta bruta del pedido como altura, no el saldo. Ruta histórica. El 85.9% de las filas son ''PaidPrev'': su saldo es cero, pero su venta bruta si suma ($1,684M, el 88% del total), así que domina el reparto. El último mes está incompleto.\nDe dónde sale: la vista pbi_bnpl.bnpl_par, sobre bnpl.par_snapshot.'"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Qué mide: Cómo se reparte porcentualmente la venta financiada viva entre los buckets de mora, mes a mes.\nUniverso y corte: Mismo universo que la grafica de barras de arriba: una fila por pedido y por corte de fin de mes, con la venta bruta del pedido como altura, no el saldo. Ruta histórica. El 85.9% de las filas son ''PaidPrev'': su saldo es cero, pero su venta bruta si suma ($1,684M, el 88% del total), así que domina el reparto. El último mes está incompleto.\nDe dónde sale: la vista pbi_bnpl.bnpl_par, sobre bnpl.par_snapshot.'"
                }
              }
            }
          }
        }
