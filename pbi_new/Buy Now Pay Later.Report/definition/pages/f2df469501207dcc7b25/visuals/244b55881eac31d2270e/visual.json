    "objects": {
      "script": [
        {
          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import seaborn as sns\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom matplotlib.ticker import FuncFormatter\nfrom matplotlib.lines import Line2D\nimport uuid\n\n### Clean Data\ng = dataset\ng = g[g[''Period'']>= ''2023-01'']\n\ng = g.sort_values(by=[''enrollment_cohort'', ''Period''], ascending=True).reset_index(drop=True)\ng[''treshold2''] = np.where((g[''Period''] == g[''enrollment_cohort'']), ''post BNPL'', g[''treshold''])\ng = g.groupby([''enrollment_cohort'', ''Period'', ''treshold2'']).agg( \n    ordersCount = (''salesOrderId'', ''sum''), \n    activeCustomers = (''netsuiteId'', ''sum'')\n).reset_index()\n\ng = g.rename(columns = {''treshold2'': ''Enrollment Stage'', ''enrollment_cohort'': ''Enrollment Cohort''})\ng[''frequency''] = g[''ordersCount''] / g[''activeCustomers'']\n\n### Plot\n\nplot = sns.relplot(data = g, x = ''Period'', y = ''activeCustomers'', hue = ''Enrollment Cohort'', \n                    kind = ''line'', style = ''Enrollment Stage'', marker = ''o'', aspect = 1.5)\n                    \n\n## Axis formats\nplt.xticks(rotation=90)\nplt.xlabel(\"Period\")\nplt.ylabel(\"Active Customers\")\nplt.ylim(0)\n#millions_formatter = FuncFormatter(lambda x, pos: f''${x :,.0f}'')\nfor ax in plot.axes.flat:\n    ax.yaxis.grid(True, which=''major'', linestyle=''--'', color=''black'', alpha=0.5)\n#    ax.yaxis.set_major_formatter(millions_formatter)\n\nplt.subplots_adjust(left=.1, top=1, bottom = .2)\nplt.show()\n\n\n'"
                }
              }
            },
